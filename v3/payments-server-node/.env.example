# Your Tagada API key: Dashboard → Settings → Access Tokens. The same key as for V2.
TAGADA_API_KEY=

# A store on the Payments API (V3). A store still on V2 refuses V3 payments
# (store_not_on_payments_api): ask TagadaPay to move it.
TAGADA_STORE_ID=

# test or live. Test mode needs a test-mode processor on the store's policy.
TAGADA_MODE=test

# The card to charge, one of:
# - a payment method id (pm_… / inst_…) saved earlier, or
# - a vault token from the browser (@tagadapay/core-js/payments-v3 tokenizes the card).
TAGADA_PAYMENT_METHOD=
TAGADA_VAULT_TOKEN=

# Where the shopper lands after a 3DS or redirect step (required to confirm a customer payment).
TAGADA_RETURN_URL=https://example.com/checkout/return

# Optional: another Tagada API origin (staging, local). Default https://api.tagada.io
# TAGADA_API_URL=
