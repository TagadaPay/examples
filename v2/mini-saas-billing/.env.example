# CRM API key — Dashboard → Settings → Access Tokens
# (or run: npx -p @tagadapay/node-sdk tagada-init you@example.com)
TAGADA_API_KEY=sk_crm_live_xxx

# Store to bill against
TAGADA_STORE_ID=store_xxx

# Set by `npm run seed`:
# TAGADA_PAYMENT_FLOW_ID=flow_xxx
# SAAS_PRICE_ID=price_xxx
# SAAS_PLAN_NAME=Pro
# SAAS_PLAN_AMOUNT=1900
# SAAS_PLAN_CURRENCY=EUR
# TAGADA_TPA_ID=tpa_xxx

PORT=3001
WEB_ORIGIN=http://localhost:5173
