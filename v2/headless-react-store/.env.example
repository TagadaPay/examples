# Copy to .env, or let `pnpm seed <API_KEY>` write it for you.
# Never commit a real API key.

# Server side only (used by scripts/seed.ts, scripts/apply-tpa.ts, scripts/deploy.ts)
TAGADA_API_KEY=
TAGADA_STORE_ID=

# Browser (public values, bundled by Vite)
VITE_STORE_ID=store_xxxxxxxxxxxx
VITE_ENVIRONMENT=production
# Optional: Google Places key for address autocomplete
VITE_GOOGLE_AUTOCOMPLETE_API_KEY=
